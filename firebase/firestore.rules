rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function hasPermission(permission) {
      return isAdmin()
        || (permission == 'orders' && hasRole('order_manager'))
        || (permission == 'catalog' && hasRole('catalog_manager'))
        || (permission == 'warehouse' && hasRole('warehouse'))
        || (permission == 'support' && hasRole('support'));
    }

    function validUserProject(projectId) {
      return request.resource.data.projectId == projectId
        && request.resource.data.keys().hasOnly(['projectId', 'checklist', 'stepChecklist', 'updatedAt'])
        && request.resource.data.checklist is list
        && request.resource.data.checklist.size() <= 100
        && (!('stepChecklist' in request.resource.data)
          || (request.resource.data.stepChecklist is list
            && request.resource.data.stepChecklist.size() <= 100))
        && request.resource.data.updatedAt is string;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || hasPermission('support');
      allow update: if signedIn()
        && ((request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'updatedAt']))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role in ['user', 'order_manager', 'catalog_manager', 'warehouse', 'support']));
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if hasPermission('catalog')
        && request.resource.data.stock == 0;
      allow delete: if false;
      allow update: if hasPermission('catalog')
        && request.resource.data.stock == resource.data.stock;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if hasPermission('catalog');
    }

    match /community_projects/{projectId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'title', 'description', 'photoUrl', 'schematicUrl', 'codeUrl', 'date'
        ])
        && request.resource.data.userName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.photoUrl is string
        && (request.resource.data.photoUrl.matches('^https://.*')
          || (request.resource.data.photoUrl.size() <= 320000
            && request.resource.data.photoUrl.matches('^data:image/webp;base64,[A-Za-z0-9+/]+={0,2}$')))
        && (!('schematicUrl' in request.resource.data)
          || request.resource.data.schematicUrl == ''
          || (request.resource.data.schematicUrl is string
            && request.resource.data.schematicUrl.matches('^https://.*')))
        && request.resource.data.codeUrl is string
        && request.resource.data.codeUrl.matches('^https://.*')
        && request.resource.data.date is string;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && commentId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'rating', 'text', 'date'])
          && request.resource.data.userName is string
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.date is string;
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      }

      match /questions/{questionId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'text', 'date'])
          && request.resource.data.userName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.date is string;
        allow update: if signedIn()
          && (get(/databases/$(database)/documents/community_projects/$(projectId)).data.userId == request.auth.uid
            || hasPermission('support'))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answer', 'answeredBy', 'answeredAt'])
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 1000
          && request.resource.data.answeredBy is string
          && request.resource.data.answeredAt is string;
        allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponCode} {
      allow get: if true;
      allow list: if hasPermission('catalog');
      allow create: if hasPermission('catalog')
        && request.resource.data.keys().hasOnly(['code', 'percent', 'minTotal', 'maxUses', 'usedCount', 'validUntil', 'active'])
        && request.resource.data.code == couponCode
        && request.resource.data.percent is int
        && request.resource.data.percent >= 1
        && request.resource.data.percent <= 80
        && request.resource.data.minTotal is int
        && request.resource.data.minTotal >= 0
        && (request.resource.data.maxUses == null || request.resource.data.maxUses is int)
        && request.resource.data.usedCount == 0
        && request.resource.data.active is bool;
      allow update: if hasPermission('catalog')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['percent', 'minTotal', 'maxUses', 'validUntil', 'active'])
          && request.resource.data.percent is int
          && request.resource.data.percent >= 1
          && request.resource.data.percent <= 80
          && request.resource.data.minTotal is int
          && request.resource.data.minTotal >= 0
          && (request.resource.data.maxUses == null || request.resource.data.maxUses is int)
          && request.resource.data.usedCount == resource.data.usedCount
          && request.resource.data.active is bool;
      allow delete: if hasPermission('catalog');
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.matches('^[a-zA-Z0-9_-]{1,120}$')
        && reviewId == request.resource.data.productId + '__' + request.auth.uid
        && request.resource.data.keys().hasOnly([
          'productId', 'userId', 'userName', 'rating', 'text', 'date', 'imageUrl'
        ])
        && request.resource.data.userName is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.date is string
        && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl == null
          || (request.resource.data.imageUrl is string
            && ((request.resource.data.imageUrl.size() <= 2000
                && request.resource.data.imageUrl.matches('^https://.*'))
              || (request.resource.data.imageUrl.size() <= 320000
                && request.resource.data.imageUrl.matches('^data:image/webp;base64,[A-Za-z0-9+/]+={0,2}$')))));
      allow delete: if hasPermission('support');
      allow update: if false;
    }

    match /users/{userId}/userProjects/{projectId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserProject(projectId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUserProject(projectId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/stockAlerts/{productId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['productId', 'createdAt'])
        && request.resource.data.productId == productId
        && request.resource.data.createdAt is string;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['notifiedAt', 'claimId', 'claimExpiresAt'])
        && (!('notifiedAt' in resource.data)
          || request.resource.data.notifiedAt == resource.data.notifiedAt)
        && (!('notifiedAt' in request.resource.data)
          || request.resource.data.notifiedAt is string)
        && (!('claimId' in request.resource.data)
          || request.resource.data.claimId is string)
        && (!('claimExpiresAt' in request.resource.data)
          || request.resource.data.claimExpiresAt is string);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/orders/$(orderId))
          || hasPermission('orders')
          || resource.data.userId == request.auth.uid);
      allow list: if hasPermission('orders')
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'delivered'
          && (!('returnRequest' in resource.data)
            || resource.data.returnRequest.status == 'rejected')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnRequest'])
          && request.resource.data.returnRequest is map
          && request.resource.data.returnRequest.keys().hasOnly(['status', 'reason', 'requestedAt'])
          && request.resource.data.returnRequest.status == 'requested'
          && request.resource.data.returnRequest.reason is string
          && request.resource.data.returnRequest.reason.size() > 0
          && request.resource.data.returnRequest.reason.size() <= 1000
          && request.resource.data.returnRequest.requestedAt is string);
      allow delete: if false;
    }

    match /inventory_movements/{movementId} {
      allow read: if hasPermission('warehouse');
      allow create: if false;
      allow update, delete: if false;
    }
  }
}
