rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validUserProject(projectId) {
      return request.resource.data.projectId == projectId
        && request.resource.data.keys().hasOnly(['projectId', 'checklist', 'updatedAt'])
        && request.resource.data.checklist is list
        && request.resource.data.checklist.size() <= 100
        && request.resource.data.updatedAt is string;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'updatedAt']);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'productId', 'userId', 'userName', 'rating', 'text', 'date'
        ])
        && request.resource.data.productId is string
        && request.resource.data.userName is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.date is string;
      allow delete: if isAdmin();
    }

    match /users/{userId}/userProjects/{projectId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserProject(projectId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUserProject(projectId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/orders/$(orderId))
          || isAdmin()
          || resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == orderId
        && request.resource.data.status == 'processing'
        && request.resource.data.verificationRequired == true
        && request.resource.data.keys().hasOnly([
          'id', 'userId', 'date', 'status', 'items', 'total', 'discount', 'delivery', 'verificationRequired'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && request.resource.data.date is string
        && request.resource.data.delivery is map
        && request.resource.data.delivery.keys().hasOnly([
          'name', 'phone', 'city', 'address', 'carrier', 'payment'
        ])
        && request.resource.data.delivery.name is string
        && request.resource.data.delivery.name.size() > 0
        && request.resource.data.delivery.name.size() <= 80
        && request.resource.data.delivery.phone is string
        && request.resource.data.delivery.phone.size() <= 20
        && request.resource.data.delivery.city is string
        && request.resource.data.delivery.city.size() <= 100
        && request.resource.data.delivery.address is string
        && request.resource.data.delivery.address.size() <= 200
        && request.resource.data.delivery.carrier is string
        && request.resource.data.delivery.payment is string;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['processing', 'delivered', 'cancelled', 'returned'];
      allow delete: if isAdmin();
    }
  }
}
